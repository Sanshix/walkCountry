page{min-height:100%;background:#fff8ed;color:#5a2f14;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",Arial,sans-serif}view,text,image,button,textarea{box-sizing:border-box}button{padding:0;margin:0;background:transparent;border:none;line-height:1}button::after{border:none}image{display:block}.safe-bottom{padding-bottom:calc(38rpx + env(safe-area-inset-bottom))}.page-bg{position:relative;min-height:100vh;background:radial-gradient(circle at 50% 0%,rgba(255,255,255,.95) 0%,rgba(255,248,237,.94) 30%,rgba(251,240,218,.95) 68%,#fff8ed 100%);overflow-x:hidden}.page-bg::after{content:'';position:absolute;left:0;right:0;bottom:0;height:190rpx;opacity:.36;pointer-events:none;background:radial-gradient(circle at 20% 78%,rgba(255,122,0,.22) 0 3rpx,transparent 4rpx),radial-gradient(circle at 78% 52%,rgba(255,122,0,.28) 0 4rpx,transparent 5rpx),repeating-radial-gradient(ellipse at 50% 100%,transparent 0 22rpx,rgba(236,166,71,.32) 24rpx 25rpx,transparent 27rpx 50rpx)}.top-row{display:flex;align-items:center;justify-content:space-between;padding:60rpx 34rpx 0;position:relative;z-index:2}.brand-pill{display:flex;align-items:center;height:64rpx;padding:0 22rpx 0 10rpx;border-radius:999rpx;border:1rpx solid rgba(243,201,141,.75);background:rgba(255,240,210,.72);box-shadow:0 12rpx 30rpx rgba(129,72,14,.12)}.brand-logo{width:48rpx;height:48rpx;margin-right:12rpx}.brand-text{font-size:26rpx;font-weight:800;color:#5a2f14}.round-btn{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;border-radius:50%;background:rgba(255,253,247,.9);color:#5a2f14;box-shadow:0 16rpx 34rpx rgba(94,55,20,.13);font-size:40rpx;font-weight:800}.back-btn{color:#5a2f14;font-size:56rpx;width: 74rpx !important;
  height: 74rpx !important;
  margin:0 !important;
}.user-ico{font-size:34rpx}.big-title{display:block;text-align:center;color:#6a320f;font-size:76rpx;line-height:1.08;font-weight:900;letter-spacing:1rpx;text-shadow:0 10rpx 30rpx rgba(145,80,18,.14)}.orange-title{color:#e85d00}.subtitle-line{display:flex;align-items:center;justify-content:center;margin-top:20rpx;color:#6b3a1f;font-size:30rpx;font-weight:700}.subtitle-line::before,.subtitle-line::after{content:'';display:block;width:92rpx;height:3rpx;margin:0 20rpx;background:linear-gradient(90deg,transparent,#ff7a00,transparent);border-radius:99rpx}.soft-card{background:rgba(255,252,244,.92);border:1rpx solid rgba(243,201,141,.65);border-radius:34rpx;box-shadow:0 16rpx 42rpx rgba(93,55,20,.10)}.primary-btn{display:flex;align-items:center;justify-content:center;height:98rpx;border-radius:999rpx;color:#fff;font-size:40rpx;font-weight:900;letter-spacing:5rpx;background:linear-gradient(180deg,#ff9d16 0%,#ff6f00 100%);box-shadow:0 20rpx 38rpx rgba(255,111,0,.28),inset 0 4rpx 0 rgba(255,255,255,.38)}.primary-btn text{margin:0 12rpx}.btn-hover{transform:scale(.985);opacity:.88}.muted{color:#9a7660}@keyframes floatPin{0%,100%{transform:translateY(0)}50%{transform:translateY(-12rpx)}}@keyframes pulse{0%,100%{transform:scale(1);opacity:.75}50%{transform:scale(1.08);opacity:1}}@keyframes shimmer{0%{opacity:.42}50%{opacity:.92}100%{opacity:.42}}@keyframes fadeUp{from{opacity:0;transform:translateY(24rpx)}to{opacity:1;transform:translateY(0)}}
.primary-btn{
  width: 400rpx !important;
}