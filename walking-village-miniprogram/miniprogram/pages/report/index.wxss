.report-page{padding-bottom:80rpx}.report-hero{position:relative;margin-top:54rpx;text-align:center}.report-hero .big-title{font-size:62rpx}.report-sub{display:block;margin:18rpx auto 24rpx;color:#6b3a1f;font-size:27rpx}.report-hero image{width:750rpx;height:260rpx;opacity:.78}.stats{display:grid;grid-template-columns:repeat(4,1fr);width:660rpx;margin:-60rpx auto 0;padding:28rpx 10rpx;position:relative;z-index:2}.stats view{display:flex;flex-direction:column;align-items:center;border-right:1rpx dashed #f3c98d}.stats view:last-child{border-right:0}.stats text:first-child{color:#7a5a42;font-size:22rpx}.stats text:last-child{margin-top:14rpx;font-size:28rpx;font-weight:900;text-align:center}.summary,.moments{width:660rpx;margin:28rpx auto 0;padding:30rpx}.section-title{display:block;font-size:30rpx;font-weight:900;color:#5a2f14;margin-bottom:20rpx}.summary-text{font-size:28rpx;line-height:1.9;color:#6b3a1f}.moment-list{display:flex;gap:18rpx}.moment{flex:1;border-radius:18rpx;overflow:hidden;background:#fff6e8;border:1rpx solid #f3c98d}.moment image{width:100%;height:160rpx}.m-title{display:block;margin:16rpx 12rpx 8rpx;font-size:25rpx;font-weight:900}.m-desc{display:block;margin:0 12rpx 18rpx;font-size:21rpx;line-height:1.45;color:#7a5a42}.dots{text-align:center;margin-top:18rpx}.dots text{display:inline-block;width:12rpx;height:12rpx;margin:0 6rpx;border-radius:50%;background:#f4d8ba}.dots text:first-child{background:#ff7a00}.report-actions{display:flex;width:660rpx;margin:34rpx auto 0;gap:24rpx}.share{flex:1;height:86rpx;line-height:85rpx;font-size:32rpx;letter-spacing:1rpx}.again{flex:1;height:86rpx;line-height:85rpx;border-radius:999rpx;border:1rpx solid #f3c98d;background:#fffaf3;color:#6b3a1f;font-size:32rpx;font-weight:900}
