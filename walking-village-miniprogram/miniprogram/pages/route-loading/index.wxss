.loading-page{padding-bottom:70rpx}.title-block{margin:54rpx 0 0}.title-block .big-title{font-size:66rpx}.generate-map{position:relative;width:710rpx;height:520rpx;margin:34rpx auto 0;overflow:hidden;padding-top:46rpx}.map-title{position:relative;z-index:3;display:block;text-align:center;font-size:34rpx;font-weight:900;color:#8a3214}.short-line{position:relative;z-index:3;width:72rpx;height:6rpx;margin:18rpx auto;background:#ff7a00;border-radius:99rpx}.map-bg{position:absolute;inset:0;width:100%;height:100%;opacity:.38}.center-bot{position:absolute;z-index:5;left:285rpx;top:210rpx;width:128rpx;height:128rpx;border-radius:50%;animation:pulse 1.8s infinite}.radar{position:absolute;z-index:4;left:230rpx;top:155rpx;width:240rpx;height:240rpx;border:3rpx solid rgba(255,122,0,.38);border-radius:50%;animation:radar 2.4s linear infinite}.r2{animation-delay:.8s}.glow-path{position:absolute;z-index:3;left:78rpx;top:245rpx;width:560rpx;height:160rpx;border:12rpx solid rgba(255,151,0,.75);border-left-color:transparent;border-radius:50%;box-shadow:0 0 24rpx rgba(255,122,0,.6);transform:rotate(8deg)}.pin{position:absolute;z-index:6;display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;border-radius:50%;background:#fff;color:#ff7a00;font-size:30rpx;box-shadow:0 0 20rpx rgba(255,122,0,.35);animation:floatPin 2s infinite}.p1{left:126rpx;top:270rpx}.p2{right:154rpx;bottom:108rpx;animation-delay:.4s}.p3{right:208rpx;top:190rpx;animation-delay:.8s}@keyframes radar{0%{transform:scale(.45);opacity:.9}100%{transform:scale(1.45);opacity:0}}.choice-summary{width:670rpx;margin:24rpx auto;padding:26rpx 36rpx}.choice-summary view{display:flex;align-items:center;height:58rpx;border-bottom:1rpx solid #f5ddc2;font-size:27rpx;color:#6b3a1f}.choice-summary view:last-child{border-bottom:0}.choice-summary text:first-child{margin-right:18rpx;color:#ff7a00}.skeleton-list{width:670rpx;margin:0 auto}.skeleton{position:relative;height:130rpx;margin:22rpx 0;border-radius:24rpx;background:rgba(255,252,244,.9);box-shadow:0 10rpx 28rpx rgba(94,55,20,.08);padding:24rpx 0 0 170rpx}.skeleton::before{content:'';position:absolute;left:28rpx;top:24rpx;width:116rpx;height:82rpx;border-radius:16rpx;background:#f5e2ca}.skeleton view{height:20rpx;margin-bottom:18rpx;border-radius:99rpx;background:#f6dfc2;animation:shimmer 1.5s infinite}.skeleton view:nth-child(1){width:180rpx}.skeleton view:nth-child(2){width:360rpx}.skeleton view:nth-child(3){width:300rpx}.spin{position:absolute;right:34rpx;top:44rpx;width:42rpx;height:42rpx;border:8rpx solid #f7dcc0;border-top-color:#ff7a00;border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.loading-tip{margin-top:36rpx;text-align:center;color:#7a3c1b;font-size:27rpx;font-weight:700}
