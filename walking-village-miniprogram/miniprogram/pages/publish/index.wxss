.publish-page{padding-bottom:70rpx}.publish-title{margin:45rpx 0 24rpx}.publish-title .big-title{font-size:56rpx}.publish-box{width:660rpx;margin:0 auto;padding:28rpx}.publish-box textarea{width:100%;height:210rpx;color:#6b3a1f;font-size:28rpx}.publish-actions{display:flex;align-items:center;margin-top:20rpx}.add-photo{display:flex;align-items:center;justify-content:center;width:150rpx;height:150rpx;border:2rpx dashed #f3c98d;border-radius:18rpx;color:#b46a2d;font-size:25rpx;white-space:pre-line}.publish-btn{flex:1;margin-left:44rpx;height:88rpx}.share-title{text-align:center;margin:42rpx 0 26rpx;color:#5a2f14;font-size:30rpx;font-weight:900}.post-card{width:660rpx;margin:0 auto 28rpx;padding:28rpx;border-radius:28rpx;background:#fff;box-shadow:0 14rpx 34rpx rgba(94,55,20,.08)}.post-head{display:flex;align-items:center}.post-head image{width:72rpx;height:72rpx;border-radius:50%;margin-right:18rpx}.name{display:block;font-size:28rpx;font-weight:900}.tag,.point-tag{padding:6rpx 14rpx;border-radius:999rpx;border:1rpx solid #f3c98d;color:#e85d00;font-size:20rpx}.time{display:block;margin-top:8rpx;color:#9a7660;font-size:22rpx}.point-tag{margin-left:auto}.post-text{display:block;margin:24rpx 0;font-size:28rpx;line-height:1.75;color:#5a2f14}.post-photo{width:300rpx;height:190rpx;border-radius:14rpx}.post-actions{display:flex;justify-content:space-around;margin-top:22rpx;border-top:1rpx solid #f2e0c8;padding-top:18rpx}.post-actions button{color:#8a5d43;font-size:25rpx}.footer-text{text-align:center;margin-top:42rpx;color:#c99a69;font-size:26rpx}
