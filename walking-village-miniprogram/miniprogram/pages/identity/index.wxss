.identity-page{padding-bottom:70rpx}.spacer{width:82rpx}.title-block{margin-top:40rpx}.title-block .big-title{font-size:70rpx}.hero-strip{position:relative;width:750rpx;height:220rpx;margin:28rpx auto -36rpx;overflow:hidden}.hero-strip image{width:100%;height:100%;opacity:.88}.strip-pin{position:absolute;left:300rpx;top:78rpx;width:58rpx;height:58rpx;border-radius:50%;background:#ff7a00;box-shadow:0 0 28rpx rgba(255,122,0,.5);animation:floatPin 2s infinite}.role-list{position:relative;z-index:2;width:662rpx;margin:0 auto}.role-card{display:flex;align-items:center;height:158rpx;margin-bottom:20rpx;padding:20rpx 30rpx;border-radius:34rpx;border:1rpx solid rgba(243,201,141,.54);background:rgba(255,252,244,.92);box-shadow:0 12rpx 32rpx rgba(94,55,20,.08);transition:all .2s}.role-card.active{border:4rpx solid #ff7a00;box-shadow:0 20rpx 42rpx rgba(255,122,0,.18);transform:translateY(-4rpx)}.role-icon{width:100rpx;height:100rpx;margin-right:34rpx;border-radius:50%}.role-text{flex:1}.role-title{display:block;color:#5a2f14;font-size:34rpx;font-weight:900}.role-desc{display:block;margin-top:14rpx;color:#6b3a1f;font-size:24rpx}.radio{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;border-radius:50%;border:3rpx solid #f3c98d;color:#fff;font-size:32rpx}.radio.checked{background:#ff7a00;border-color:#ff7a00}.progress{display:flex;flex-direction:column;align-items:center;margin:30rpx 0 18rpx;color:#ff7a00;font-size:28rpx;font-weight:700}.progress::before{content:'';width:250rpx;height:12rpx;border-radius:99rpx;background:linear-gradient(90deg,#ff7a00 0 25%,#f5dbc0 25% 100%);margin-bottom:12rpx}.next-btn{width:580rpx;margin:0 auto}
.back-btn{width: 74rpx !important;
  height: 74rpx !important;
  margin:0 !important;
}
