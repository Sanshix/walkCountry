.semi-auth-page {
  min-height: 100vh;
  background: #fffaf0;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f4d99d;
  border-top-color: #ef7b13;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 32rpx;
  color: #5a2f14;
  font-size: 28rpx;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 0 60rpx;
}

.error-icon {
  font-size: 80rpx;
}

.error-title {
  margin-top: 24rpx;
  color: #5a2f14;
  font-size: 36rpx;
  font-weight: 700;
}

.error-desc {
  margin-top: 16rpx;
  color: rgba(90, 47, 20, 0.68);
  font-size: 26rpx;
  text-align: center;
}

.retry-btn, .back-btn {
  margin-top: 32rpx;
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  padding: 0;
}

.retry-btn {
  background: linear-gradient(135deg, #ef7b13, #f4a24a);
  color: #fff;
}

.back-btn {
  background: rgba(255, 253, 247, 0.88);
  border: 2rpx solid rgba(185, 111, 38, 0.62);
  color: #5a2f14;
}

/* 手动授权流程样式 */
.manual-auth {
  padding: 60rpx 40rpx;
}

.manual-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.manual-title {
  display: block;
  color: #5a2f14;
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.manual-desc {
  display: block;
  margin-top: 16rpx;
  color: rgba(95, 68, 45, 0.68);
  font-size: 28rpx;
}

.steps {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 16rpx 34rpx rgba(94, 61, 25, 0.08);
}

.step-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.step-num {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #ef7b13;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 50%;
  margin-right: 20rpx;
}

.step-text {
  color: #5a2f14;
  font-size: 28rpx;
  line-height: 48rpx;
}

.copy-btn, .submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  padding: 0;
  margin: 24rpx 0;
}

.copy-btn {
  background: rgba(239, 123, 19, 0.1);
  border: 2rpx solid #ef7b13;
  color: #ef7b13;
}

.submit-btn {
  background: linear-gradient(135deg, #ef7b13, #f4a24a);
  color: #fff;
  margin-top: 32rpx;
}

.auth-code-input {
  margin-top: 32rpx;
}

.input-label {
  display: block;
  color: #5a2f14;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.code-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid rgba(228, 169, 92, 0.5);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #5a2f14;
}
