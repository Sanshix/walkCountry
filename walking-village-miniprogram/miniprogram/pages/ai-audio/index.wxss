.audio-page{padding-bottom:70rpx}.page-title{font-size:34rpx;font-weight:900;justify-content: start !important;}.ai-audio-head{display:flex !important; align-items: center;}.audio-header{margin-top:58rpx}.audio-panel{width:700rpx;margin:38rpx auto 0;padding:34rpx}.talking{display:block;font-size:32rpx;font-weight:900;margin-bottom:28rpx}.player{display:flex;align-items:center}.player image{width:130rpx;height:130rpx;border-radius:50%;margin-right:30rpx}.bot-name{font-size:32rpx;font-weight:900}.ai-tag{padding:4rpx 14rpx;border-radius:999rpx;border:1rpx solid #f3c98d;color:#ff7a00;font-size:20rpx}.bot-sub{display:block;margin-top:12rpx;color:#8a5d43;font-size:25rpx}.play-btn{display:flex;align-items:center;justify-content:center;width:120rpx !important;height:120rpx !important;margin:28rpx auto;border-radius:50%;background:#ff7a00;color:#fff;font-size:48rpx;box-shadow:0 16rpx 32rpx rgba(255,122,0,.25)}.progress-row{display:flex;align-items:center;gap:16rpx;color:#6b3a1f;font-size:24rpx}.progress{flex:1;height:8rpx;background:#f4d8ba;border-radius:999rpx}.progress view{height:100%;border-radius:999rpx;background:#ff7a00}.speed{width:80rpx !important;height:44rpx; line-height:44rpx;border-radius:999rpx;border:1rpx solid #f3c98d;color:#ff7a00;font-size:25rpx;}.wave{display:flex;align-items:center;justify-content:center;height:122rpx;margin-top:22rpx}.wave text{width:7rpx;margin:0 5rpx;border-radius:99rpx;background:#ff7a00;opacity:.45}.wave.playing text{animation:wave .9s ease-in-out infinite}.wave.playing text:nth-child(2n){animation-delay:.15s}.wave.playing text:nth-child(3n){animation-delay:.3s}@keyframes wave{0%,100%{transform:scaleY(.55);opacity:.45}50%{transform:scaleY(1.2);opacity:1}}.expand{display:flex;align-items:center;
  justify-content: space-around;
  gap:30rpx; height:72rpx;line-height:71rpx;border-radius:18rpx;border:1rpx solid #f3c98d;color:#6b3a1f;font-size:27rpx}.script-card{margin-top:26rpx;padding:28rpx;border-radius:22rpx;background:#fffaf2}.script-title{display:block;font-size:30rpx;font-weight:900}.script-text{display:block;margin-top:18rpx;font-size:28rpx;line-height:1.9;color:#6b3a1f}.task-remind{margin-top:26rpx;padding:28rpx;border-radius:22rpx;background:#fffaf2;color:#6b3a1f;font-size:26rpx}

.top-row {
  display: grid !important;
  grid-template-columns: 1fr auto 1fr;   /* 左右等宽，中间自适应 */
  align-items: center;
  min-height: 44px;
}

.top-row {
  justify-self: start !important;       /* 靠左放置在第一列 */
}

.page-title {
  justify-self: center !important;      /* 在中间列居中 */
  text-align: center;
}
