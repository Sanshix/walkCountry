.home-page {
  position: relative;
  min-height: 1700rpx;
  overflow-x: hidden;
  background: #fff8ed;
}

.page-bg-img,
.page-bg-fallback {
  position: absolute;
  top: 0;
  left: 0;
  width: 750rpx;
  height: 1700rpx;
  pointer-events: none;
}

.page-bg-img {
  z-index: 0;
}

.page-bg-fallback {
  z-index: -1;
  background:
    radial-gradient(circle at 48% 0%, rgba(255, 255, 255, 0.96) 0%, rgba(255, 248, 237, 0.86) 26%, rgba(251, 238, 213, 0.92) 62%, #fff8ed 100%),
    linear-gradient(180deg, #fffaf0 0%, #fbefd6 100%);
}

.home-content {
  position: relative;
  z-index: 2;
  min-height: 1700rpx;
  padding-bottom: 70rpx;
}

.home-top {
  height: 96rpx;
  padding: 80rpx 34rpx 0;
  display: flex;
  justify-content: space-between;
}

.home-brand {
  height: 62rpx;
  min-width: 236rpx;
  padding: 0 24rpx 0 9rpx;
  background: rgba(255, 239, 210, 0.78);
  border: 1rpx solid rgba(232, 176, 91, 0.48);
  box-shadow: 0 10rpx 26rpx rgba(122, 65, 10, 0.12);
}

.home-brand .brand-logo {
  width: 52rpx;
  height: 52rpx;
  margin-right: 13rpx;
}

.home-brand .brand-text {
  font-size: 26rpx;
  font-weight: 900;
  color: #5a2f14;
  letter-spacing: 1rpx;
}

.user-btn {
  width: 74rpx !important;
  height: 74rpx !important;
  margin-top: -6rpx;
  position: relative;
  margin-left:0 !important;
  justify-content: space-between;
}

.user-head {
  position: absolute;
  top: 18rpx;
  left: 26rpx;
  width: 22rpx;
  height: 22rpx;
  border: 5rpx solid #5a2f14;
  border-radius: 50%;
}

.user-body {
  position: absolute;
  left: 19rpx;
  bottom: 17rpx;
  width: 36rpx;
  height: 23rpx;
  border: 5rpx solid #5a2f14;
  border-top: none;
  border-radius: 0 0 22rpx 22rpx;
}

.title-section {
  position: relative;
  z-index: 3;
  width: 540rpx;
  height: 194rpx;
  margin: 16rpx auto 0;
}

.main-title-img {
  width: 540rpx;
  height: 194rpx;
}

.title-text-fallback {
  width: 680rpx;
  height: 194rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.home-main-title {
  display: block;
  text-align: center;
  color: #6a320f;
  font-size: 84rpx;
  line-height: 1.05;
  font-weight: 900;
  letter-spacing: 1rpx;
  text-shadow: 0 10rpx 26rpx rgba(145, 80, 18, 0.12);
}
.user-btn{
  width:80rpx;
  height: 80rpx;
}
.hero-card {
  position: relative;
  z-index: 4;
  width: 648rpx;
  height: 523rpx;
  margin: 11rpx auto 0;
  border-radius: 48rpx;
  overflow: hidden;
  border: 7rpx solid rgba(255, 255, 255, 0.98);
  background: #f6e9cc;
  box-shadow: 0 24rpx 52rpx rgba(94, 55, 20, 0.18);
}

.hero-img,
.hero-fallback,
.hero-warm-mask,
.route-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-img {
  z-index: 1;
}

.hero-fallback {
  z-index: 1;
  background:
    linear-gradient(180deg, rgba(255, 245, 209, 0.82), rgba(244, 203, 90, 0.32) 42%, rgba(112, 139, 77, 0.34)),
    radial-gradient(circle at 72% 30%, #edd8a4 0 80rpx, transparent 82rpx),
    linear-gradient(180deg, #e9e6c9, #f5db8f 56%, #93a460);
}

.hero-warm-mask {
  z-index: 2;
  background:
    linear-gradient(180deg, rgba(255, 248, 225, 0.56) 0%, rgba(255, 248, 225, 0.12) 42%, rgba(51, 40, 18, 0.06) 100%),
    linear-gradient(90deg, rgba(255, 248, 225, 0.28) 0%, transparent 40%);
}

.hero-copy {
  position: absolute;
  z-index: 7;
  top: 48rpx;
  left: 42rpx;
  display: flex;
  flex-direction: column;
  color: #5a2f14;
  font-size: 29rpx;
  line-height: 1.85;
  font-weight: 800;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(255, 248, 225, 0.92);
}

.copy-line {
  width: 68rpx;
  height: 7rpx;
  margin-top: 8rpx;
  border-radius: 99rpx;
  background: #ff7300;
  box-shadow: 0 4rpx 12rpx rgba(255, 115, 0, 0.22);
}

.route-overlay {
  z-index: 4;
  opacity: 0.98;
}

.ai-radar {
  position: absolute;
  z-index: 5;
  left: 76rpx;
  bottom: 68rpx;
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(255, 255, 255, 0.78);
  animation: radarSpin 7s linear infinite;
}

.ai-radar::before,
.ai-radar::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
}

.ai-radar::before {
  inset: 22rpx;
}

.ai-radar::after {
  inset: 44rpx;
}

.home-ai-bot {
  position: absolute;
  z-index: 8;
  left: 116rpx;
  bottom: 106rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  filter: drop-shadow(0 0 16rpx rgba(255, 255, 255, 0.9));
  animation: aiWalk 6.2s ease-in-out infinite, pulse 2.1s ease-in-out infinite;
}

.home-pin {
  position: absolute;
  z-index: 8;
  right: 216rpx;
  bottom: 205rpx;
  width: 96rpx;
  height: 96rpx;
  animation: floatPin 2.1s ease-in-out infinite;
  filter: drop-shadow(0 0 22rpx rgba(255, 122, 0, 0.75));
}

.node {
  position: absolute;
  z-index: 9;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #ff9a16;
  box-shadow: 0 0 18rpx rgba(255, 122, 0, 0.92);
  animation: shimmer 1.45s infinite;
}

.node1 { left: 150rpx; bottom: 44rpx; }
.node2 { left: 335rpx; bottom: 95rpx; animation-delay: .3s; }
.node3 { left: 424rpx; bottom: 176rpx; animation-delay: .6s; }

.intro-block {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100vw;
  height: 246rpx;
  margin: -18rpx auto 0;
  padding: 58rpx 42rpx 30rpx 42rpx;
}

.intro-texts {
  display: flex;
  flex-direction: column;
  color: #5d331a;
  font-size: 24rpx;
  line-height: 1.92;
  font-weight: 650;
  letter-spacing: 1rpx;
}
.bottom-bgBox{
  border-radius:52rpx 52rpx  0 0 ;
  background: rgba(255, 250, 239, 0.80);
  padding:0 0 30rpx 0;
}
.mini-route {
  position: relative;
  width: 166rpx;
  height: 132rpx;
  opacity: 0.92;
}
.route-img{
  width:150rpx;
  height:140rpx;

}
.mini-route-halo {
  position: absolute;
  right: -8rpx;
  top: 0;
  width: 130rpx;
  height: 104rpx;
  border-radius: 50%;
  background: rgba(255, 226, 171, 0.32);
}

.mini-pin {
  position: absolute;
  right: 50rpx;
  top: 4rpx;
  width: 36rpx;
  height: 48rpx;
  border-radius: 50% 50% 50% 0;
  background: #ff8a00;
  transform: rotate(-45deg);
  box-shadow: 0 8rpx 18rpx rgba(255, 138, 0, .25);
}

.mini-pin::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ffffff;
}

.mini-road {
  position: absolute;
  left: 18rpx;
  top: 46rpx;
  width: 128rpx;
  height: 64rpx;
  border-bottom: 5rpx dashed #e99a25;
  border-radius: 50%;
  transform: rotate(14deg);
}

.mini-house {
  position: absolute;
  left: 23rpx;
  bottom: 5rpx;
  width: 86rpx;
  height: 42rpx;
  border-radius: 10rpx;
  background: #d8b073;
}

.mini-tree {
  position: absolute;
  left: 12rpx;
  bottom: 26rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #93a45a;
}

.home-primary {
  position: relative;
  z-index: 4;
  width: 400rpx !important;
  height: 112rpx;
  margin: 24rpx auto 0;
  border: 5rpx solid rgba(255, 255, 255, 0.92);
  font-size: 42rpx;
  letter-spacing: 8rpx;
  box-shadow: 0 20rpx 44rpx rgba(255, 111, 0, 0.32), inset 0 4rpx 0 rgba(255, 255, 255, 0.42);
}

.home-primary .spark {
  font-size: 40rpx;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
 
}

.home-primary .arrow {
  font-size: 56rpx;
  margin-left: 24rpx;
  line-height: 1;
}

.guide-btn {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 400rpx !important;
  height: 112rpx;
  margin: 23rpx auto 0;
  padding: 0 34rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(243, 201, 141, 0.9);
  background: rgba(255, 253, 246, 0.82);
  box-shadow: 0 12rpx 30rpx rgba(94, 55, 20, 0.08);
  color: #5a2f14;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.guide-robot {
  color: #ff7a00;
  font-size: 34rpx;
}

.guide-arrow {
  color: #8a542c;
  font-size: 46rpx;
}

.features {
  position: relative;
  z-index: 4;
  display: flex;
  gap: 22rpx;
  width: 644rpx;
  margin: 28rpx auto 0;
}

.feature-card {
  position: relative;
  flex: 1;
  height: 136rpx;
  padding: 18rpx 10rpx 12rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(243, 201, 141, 0.66);
  background: rgba(255, 252, 244, 0.9);
  box-shadow: 0 12rpx 30rpx rgba(94, 55, 20, 0.08);
  display: flex;
  align-items: center;
}

.feature-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 7rpx 10rpx rgba(176, 96, 15, .16));
}

.feature-title {
  display: block;
  color: #5a2f14;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
}

.feature-desc {
  display: block;
  margin-top: 8rpx;
  color: #7b5b45;
  font-size: 18rpx;
  line-height: 1.45;
  white-space: pre-line;
}

.feature-link {
  position: absolute;
  top: 64rpx;
  width: 26rpx;
  border-top: 5rpx dotted rgba(255, 137, 16, 0.72);
}

.link-one { left: 203rpx; }
.link-two { left: 420rpx; }

@keyframes aiWalk {
  0%, 100% { left: 116rpx; bottom: 106rpx; }
  24% { left: 184rpx; bottom: 82rpx; }
  48% { left: 318rpx; bottom: 120rpx; }
  70% { left: 392rpx; bottom: 187rpx; }
  88% { left: 426rpx; bottom: 226rpx; }
}

@keyframes radarSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
