.result-page {
  padding-bottom: 70rpx;
}

.result-title {
  font-size: 64rpx;
  margin-top: 50rpx;
}

.route-panel {
  width: 700rpx;
  margin: 34rpx auto 0;
  padding: 32rpx 24rpx;
}

.route-name {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: #5a2f14;
  margin-bottom: 18rpx;
}

.tags {
  display: flex;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.tags text {
  padding: 12rpx 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid #f3c98d;
  background: #fff3de;
  font-size: 24rpx;
  color: #6b3a1f;
}

.route-desc {
  display: block;
  width: 380rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #6b3a1f;
}

.route-info {
  position: relative;
  z-index: 5;
}

/* 地图区域 */
.map-section {
  position: relative;
  margin-top: 24rpx;
  border-radius: 26rpx;
  overflow: hidden;
}

.real-map {
  width: 100%;
  height: 420rpx;
  border-radius: 26rpx;
}

.map-overlay {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  z-index: 10;
}

.route-badge {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: rgba(255, 122, 0, 0.95);
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 122, 0, 0.3);
}

.badge-icon {
  color: #fff;
  font-size: 24rpx;
  margin-right: 8rpx;
}

.badge-text {
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

/* 备用静态地图 */
.map-card {
  position: relative;
  height: 420rpx;
  border-radius: 26rpx;
  overflow: hidden;
}

.map-card image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: .78;
}

.map-line {
  position: absolute;
  left: 100rpx;
  top: 230rpx;
  width: 480rpx;
  height: 150rpx;
  border: 12rpx solid #ff8a00;
  border-left-color: transparent;
  border-radius: 50%;
  transform: rotate(-12deg);
  box-shadow: 0 0 20rpx rgba(255, 122, 0, .34);
}

.map-pin {
  position: absolute;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 72rpx;
  border-radius: 50% 50% 50% 0;
  background: #ff7a00;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  transform: rotate(-45deg);
  box-shadow: 0 0 0 5rpx #fff;
}

.map-pin text {
  transform: rotate(45deg);
}

.pin-0 { left: 70rpx; bottom: 44rpx; }
.pin-1 { left: 360rpx; top: 135rpx; }
.pin-2 { right: 90rpx; top: 58rpx; }
.pin-3 { right: 130rpx; bottom: 82rpx; }
.pin-4 { left: 330rpx; bottom: 38rpx; }

/* 点位列表 */
.point-list {
  margin-top: 28rpx;
}

.point-item {
  position: relative;
  display: flex;
  align-items: center;
  height: 140rpx;
  margin-bottom: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .72);
}

.point-item image {
  width: 132rpx;
  height: 92rpx;
  border-radius: 16rpx;
  margin-right: 26rpx;
}

.order-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ff7a00;
  color: #fff;
  font-weight: 900;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.point-info {
  flex: 1;
  overflow: hidden;
}

.point-name {
  display: block;
  color: #5a2f14;
  font-size: 30rpx;
  font-weight: 900;
}

.point-sub {
  display: block;
  margin-top: 6rpx;
  color: #8a5d43;
  font-size: 22rpx;
}

.point-location {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.location-icon {
  font-size: 20rpx;
  margin-right: 4rpx;
}

.location-text {
  font-size: 20rpx;
  color: #a15021;
}

.duration {
  font-size: 23rpx;
  color: #a15021;
  flex-shrink: 0;
}

.start-btn {
  margin-top: 26rpx;
  height: 100rpx;
}