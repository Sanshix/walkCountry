<view class="page-bg result-page safe-bottom">
  <view class="top-row">
    <button class="round-btn back-btn" bindtap="goBack">‹</button>
  </view>
  <text class="big-title result-title">你的专属路线已生成</text>

  <view class="route-panel soft-card">
    <view class="route-info">
      <text class="route-name">{{route.routeName}}</text>
      <view class="tags">
        <text>◷ 总时长 {{route.totalDuration}}</text>
        <text>⌖ {{route.pointCount}} 个点位</text>
      </view>
      <text class="route-desc">{{route.routeDesc}}</text>
    </view>

    <!-- 真实地图区域 -->
    <view class="map-section">
      <map
        class="real-map"
        latitude="{{mapCenter.lat}}"
        longitude="{{mapCenter.lng}}"
        scale="15"
        show-location="{{true}}"
        enable-rotate="{{false}}"
        markers="{{markers}}"
        bindmarkertap="onMarkerTap"
      >
        <!-- 连接线 -->
        <cover-view class="map-overlay">
          <cover-view class="route-badge">
            <cover-view class="badge-icon">✦</cover-view>
            <cover-view class="badge-text">AI推荐路线</cover-view>
          </cover-view>
        </cover-view>
      </map>

      <!-- 备用静态地图（当没有坐标数据时） -->
      <view class="map-card" wx:if="{{!hasValidCoordinates}}">
        <image src="{{route.mapImage}}" mode="aspectFill"></image>
        <view class="map-line"></view>
        <block wx:for="{{route.points}}" wx:key="id">
          <view class="map-pin pin-{{index}}">{{item.order}}</view>
        </block>
      </view>
    </view>

    <view class="point-list">
      <block wx:for="{{route.points}}" wx:key="id">
        <view class="point-item" bindtap="openPoint" data-id="{{item.id}}" data-index="{{index}}">
          <image src="{{item.image}}" mode="aspectFill"></image>
          <view class="order-dot">{{item.order}}</view>
          <view class="point-info">
            <text class="point-name">{{item.name}}</text>
            <text class="point-sub">{{item.subtitle}}</text>
            <view class="point-location" wx:if="{{item.location}}">
              <text class="location-icon">📍</text>
              <text class="location-text">{{item.location}}</text>
            </view>
          </view>
          <text class="duration">◷ {{item.duration}}</text>
        </view>
      </block>
    </view>

    <button class="primary-btn start-btn" bindtap="startRoute" hover-class="btn-hover">
      <text>✦</text>
      <text>开始游览</text>
    </button>
  </view>
</view>
