.point-page{padding-bottom:70rpx}.page-title{font-size:34rpx;font-weight:900;color:#5a2f14}.station-pill{padding:14rpx 22rpx;border-radius:999rpx;background:#fff3de;border:1rpx solid #f3c98d;font-size:24rpx;color:#6b3a1f}.station-pill text{color:#ff7a00;font-weight:900}.point-hero{width:660rpx;height:440rpx;margin:46rpx auto 0;border-radius:34rpx;box-shadow:0 22rpx 44rpx rgba(94,55,20,.16)}.dots{display:flex;justify-content:center;margin-top:-28rpx}.dots text{width:12rpx;height:12rpx;margin:0 6rpx;border-radius:50%;background:#fff}.dots text:first-child{background:#ff7a00}.content{width:660rpx;margin:34rpx auto 0}.point-title{font-size:54rpx;font-weight:900;color:#5a2f14}.meta{display:flex;gap:28rpx;margin:24rpx 0}.meta text{padding:14rpx 22rpx;border-radius:999rpx;border:1rpx solid #f3c98d;background:#fff8ec;color:#6b3a1f;font-size:24rpx}.story-card,.task-card{padding:32rpx;margin-top:26rpx}.card-title{font-size:32rpx;font-weight:900;color:#5a2f14;margin-bottom:22rpx}.story-text{display:block;font-size:29rpx;line-height:1.8;color:#6b3a1f}.highlight{display:block;margin-top:14rpx;color:#e85d00;font-size:29rpx;line-height:1.6}.audio-btn{height:92rpx;margin-top:30rpx;font-size:34rpx}.audio-btn .sub{display:block;font-size:22rpx;letter-spacing:0;font-weight:600;margin-top:8rpx}.task-row{display:flex;align-items:center}.camera-illus{display:flex;align-items:center;justify-content:center;width:178rpx;height:140rpx;margin-right:28rpx;border-right:1rpx dashed #f3c98d;font-size:70rpx;color:#ff7a00}.task-text{display:block;font-size:28rpx;line-height:1.7;color:#6b3a1f}.record-btn{display:flex;align-items:center;justify-content:center;width:200rpx;height:64rpx;margin-top:18rpx;border-radius:999rpx;border:1rpx solid #f3c98d;background:#fff8ed;color:#e85d00;font-size:26rpx;font-weight:800}.next-btn{width:600rpx;margin:32rpx auto 0}
.top-row {
  display: grid !important;
  grid-template-columns: 1fr auto 1fr;   /* 左右等宽，中间自适应 */
  align-items: center;
  min-height: 44px;
}

.top-row {
  justify-self: start !important;       /* 靠左放置在第一列 */
}

.page-title {
  justify-self: center !important;      /* 在中间列居中 */
  text-align: center;
}