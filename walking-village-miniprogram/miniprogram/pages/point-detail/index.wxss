.point-page {
  padding-bottom: 70rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #5a2f14;
}

.station-pill {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #fff3de;
  border: 1rpx solid #f3c98d;
  font-size: 24rpx;
  color: #6b3a1f;
}

.station-pill text {
  color: #ff7a00;
  font-weight: 900;
}

/* Banner轮播区域 */
.banner-section {
  position: relative;
  width: 660rpx;
  margin: 46rpx auto 0;
}

.point-swiper {
  width: 100%;
  height: 440rpx;
  border-radius: 34rpx;
  overflow: hidden;
  box-shadow: 0 22rpx 44rpx rgba(94, 55, 20, .16);
}

.swiper-img {
  width: 100%;
  height: 100%;
}

.swiper-counter {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 8rpx 16rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 20rpx;
  color: #fff;
  font-size: 22rpx;
}

/* 故事卡片轮播项 */
.story-slide {
  width: 100%;
  height: 100%;
  padding: 40rpx;
  background: linear-gradient(135deg, #fffaf0, #fff3de);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.slide-label {
  font-size: 24rpx;
  color: #ff7a00;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.slide-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #5a2f14;
  margin-bottom: 24rpx;
}

.slide-story {
  font-size: 26rpx;
  color: #6b3a1f;
  line-height: 1.8;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.slide-highlight {
  font-size: 26rpx;
  color: #e85d00;
  line-height: 1.6;
  font-weight: 600;
}

/* 距离下一个点显示 */
.distance-section {
  width: 660rpx;
  margin: 24rpx auto 0;
}

.distance-card {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  background: rgba(255, 122, 0, 0.08);
  border: 1rpx solid rgba(255, 122, 0, 0.2);
  border-radius: 20rpx;
}

.distance-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.distance-info {
  flex: 1;
}

.distance-label {
  display: block;
  font-size: 22rpx;
  color: #8a542c;
}

.distance-name {
  display: block;
  font-size: 26rpx;
  color: #5a2f14;
  font-weight: 700;
  margin-top: 4rpx;
}

.distance-value {
  text-align: right;
}

.distance-num {
  font-size: 40rpx;
  font-weight: 900;
  color: #ff7a00;
}

.distance-unit {
  font-size: 22rpx;
  color: #8a542c;
  margin-left: 4rpx;
}

.walk-time {
  width: 100%;
  margin-top: 12rpx;
  text-align: right;
}

.walk-time text {
  font-size: 22rpx;
  color: #8a542c;
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 12rpx;
}

.content {
  width: 660rpx;
  margin: 34rpx auto 0;
}

.point-title {
  font-size: 54rpx;
  font-weight: 900;
  color: #5a2f14;
}

.meta {
  display: flex;
  gap: 28rpx;
  margin: 24rpx 0;
}

.meta text {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #f3c98d;
  background: #fff8ec;
  color: #6b3a1f;
  font-size: 24rpx;
}

.story-card,
.task-card {
  padding: 32rpx;
  margin-top: 26rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #5a2f14;
  margin-bottom: 22rpx;
}

.story-text {
  display: block;
  font-size: 29rpx;
  line-height: 1.8;
  color: #6b3a1f;
}

.highlight {
  display: block;
  margin-top: 14rpx;
  color: #e85d00;
  font-size: 29rpx;
  line-height: 1.6;
}

.audio-btn {
  height: 92rpx;
  margin-top: 30rpx;
  font-size: 34rpx;
}

.audio-btn .sub {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0;
  font-weight: 600;
  margin-top: 8rpx;
}

/* 语音播放进度条 */
.audio-progress {
  margin-top: 20rpx;
  padding: 16rpx 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 8rpx;
  background: rgba(255, 122, 0, 0.2);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff7a00, #ff9a16);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-time {
  font-size: 22rpx;
  color: #8a542c;
}

.stop-btn {
  padding: 8rpx 20rpx;
  background: rgba(255, 122, 0, 0.1);
  border: 1rpx solid #ff7a00;
  border-radius: 16rpx;
  color: #ff7a00;
  font-size: 22rpx;
  font-weight: 600;
}

.task-row {
  display: flex;
  align-items: center;
}

.camera-illus {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 178rpx;
  height: 140rpx;
  margin-right: 28rpx;
  border-right: 1rpx dashed #f3c98d;
  font-size: 70rpx;
  color: #ff7a00;
}

.task-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #6b3a1f;
}

.record-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 64rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #f3c98d;
  background: #fff8ed;
  color: #e85d00;
  font-size: 26rpx;
  font-weight: 800;
}

.next-btn {
  width: 600rpx;
  margin: 32rpx auto 0;
}

.top-row {
  display: grid !important;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  min-height: 44px;
}

.top-row {
  justify-self: start !important;
}

.page-title {
  justify-self: center !important;
  text-align: center;
}