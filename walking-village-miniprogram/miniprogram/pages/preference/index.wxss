.pref-page{padding-bottom:72rpx}.title-block{margin:50rpx 0 0}.title-block .big-title{font-size:64rpx}.pref-hero{width:750rpx;height:250rpx;margin:20rpx 0 -20rpx;opacity:.86}.section-card{position:relative;z-index:2;width:710rpx;margin:28rpx auto 0;padding:38rpx 28rpx}.section-head{display:flex;align-items:center;margin-bottom:32rpx}.section-icon{display:flex;align-items:center;justify-content:center;width:56rpx;height:56rpx;margin-right:20rpx;border-radius:50%;background:#ff7a00;color:#fff;font-size:30rpx}.section-title{display:block;font-size:34rpx;font-weight:900;color:#5a2f14}.section-desc{display:block;margin-top:8rpx;color:#8a5d43;font-size:24rpx}.interest-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22rpx}.choice{position:relative;height:150rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border:2rpx solid #efd7bd;border-radius:20rpx;color:#6b3a1f;font-size:27rpx;font-weight:700;background:rgba(255,255,255,.58)}.choice-icon{font-size:42rpx;margin-bottom:16rpx}.choice.selected,.time-choice.selected{border:4rpx solid #ff7a00;color:#ff7a00;box-shadow:0 12rpx 28rpx rgba(255,122,0,.12)}.check{position:absolute;right:-18rpx;top:-18rpx;display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;border-radius:50%;background:#ff7a00;color:#fff;font-size:34rpx}.time-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18rpx}.time-choice{position:relative;height:120rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border:2rpx solid #efd7bd;border-radius:20rpx;background:rgba(255,255,255,.58);font-size:26rpx;color:#6b3a1f}.time-icon{font-size:34rpx;margin-bottom:12rpx}.summary-card{display:flex;align-items:center;width:710rpx;margin:28rpx auto;padding:24rpx;border-radius:28rpx;border:1rpx solid #f3c98d;background:rgba(255,249,236,.86)}.summary-card image{width:106rpx;height:106rpx;border-radius:50%;margin-right:22rpx}.summary-title{display:block;font-size:28rpx;font-weight:900;color:#5a2f14}.summary-desc{display:block;margin-top:10rpx;font-size:23rpx;color:#8a5d43;line-height:1.5}.generate-btn{width:670rpx;margin:0 auto;height:106rpx}
